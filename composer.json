{
    "name": "joejohnson-r52/media-compressor",
    "type": "wordpress-plugin",
    "description": "Compress and resize images in the browser before they are uploaded to the WordPress Media Library.",
    "license": "MIT",
    "authors": [
        {
            "name": "Joe Johnson"
        }
    ],
    "require": {
        "php": ">=8.1",
        "composer/installers": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "MediaCompressor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MediaCompressor\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "test": [
            "phpunit",
            "node --import ./tests/js/setup.mjs --test 'tests/js/*.test.mjs'"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
